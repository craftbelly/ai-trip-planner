# =============================================================================
# REQUIRED: Choose ONE LLM provider
# =============================================================================

# Option 1: OpenAI (recommended)
#OPENAI_API_KEY=your-openai-api-key-here

# Option 2: OpenRouter (alternative)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# =============================================================================
# REQUIRED: Phoenix Tracing Configuration
# =============================================================================

# Get these from https://app.phoenix.arize.com/ -> Settings
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_API_KEY=your-phoenix-api-key-here

# =============================================================================
# OPTIONAL: Enhanced Features
# =============================================================================

# Enable RAG with local guides (set to 1 to enable)
ENABLE_RAG=1

# Embedding Provider (choose one):
# Option 1: HuggingFace (FREE, open-source, runs locally)
USE_HUGGINGFACE_EMBEDDINGS=1
HUGGINGFACE_EMBED_MODEL=all-MiniLM-L6-v2

# Option 2: OpenAI embeddings (requires OPENAI_API_KEY, costs ~$0.02/1M tokens)
# USE_HUGGINGFACE_EMBEDDINGS=0
# OPENAI_EMBED_MODEL=text-embedding-3-small

# =============================================================================
# OPTIONAL: Location & Search APIs
# =============================================================================

# HERE API (recommended for location/brewery search with addresses)
# Get API key from https://platform.here.com/
HERE_API_KEY=your-here-api-key-here

# Tavily API (fallback for general web search)
TAVILY_API_KEY=your-tavily-api-key-here

# SerpAPI (alternative search API)
# SERPAPI_API_KEY=your-serpapi-api-key-here

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Set to 1 for testing with mock LLM responses
# TEST_MODE=0
